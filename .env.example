# UK Wind Power Day-Ahead Trading Desk - Environment Configuration

# Backend API Configuration
PORT=8000
DECISION_CUTOFF_HOUR=9
DELIVERY_START=2026-01-02
DELIVERY_END=2026-02-01
DATA_DIR=data
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,https://your-frontend.vercel.app

# Frontend Configuration (Used at build time for Vite)
# If empty, frontend uses relative paths (/api/...) proxied via Vite dev server or Nginx
VITE_API_URL=http://localhost:8000

