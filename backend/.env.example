# Environment variables for the backend.
# Copy to .env and adjust as needed.

# Decision cutoff hour (0-23, UK time). Default 9 = 09:00.
# EPEX Spot GB day-ahead gate closure is 09:20 UK time.
DECISION_CUTOFF_HOUR=9

# Delivery day window (inclusive)
DELIVERY_START=2026-01-02
DELIVERY_END=2026-02-01

# Path to Parquet data snapshots (relative to backend/)
DATA_DIR=data

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Elexon API base URL (only used by fetch_data.py, not at runtime)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
